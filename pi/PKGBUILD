# Maintainer: Travis Lyons <pkgbuild at trly dot dev>
pkgname=pi
pkgver=0.87.0 # renovate: datasource=github-tags depName=earendil-works/pi
pkgrel=2
pkgdesc="Minimal terminal coding harness"
arch=('x86_64')
url="https://github.com/earendil-works/pi"
license=('MIT')

depends=('bash' 'gcc-libs' 'glibc')
options=('!debug' '!strip')

source=("${pkgname}-${pkgver}-linux-x64.tar.gz::${url}/releases/download/v${pkgver}/pi-linux-x64.tar.gz"
        "LICENSE-${pkgver}::${url}/raw/v${pkgver}/LICENSE")
sha256sums=('2494f5587a8774a10296d00a7e504e7ad05596ca93e057cb89372c8b1a7f46a9'
            '0457f5bcec3b3b211605dfb5d1a49042fd638f3686a410fe099c24a25af13c48')

package() {
  install -d "${pkgdir}/usr/lib/${pkgname}"
  cp -a pi/. "${pkgdir}/usr/lib/${pkgname}/"
  install -d "${pkgdir}/usr/bin"
  ln -s "/usr/lib/${pkgname}/pi" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
