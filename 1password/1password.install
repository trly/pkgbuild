# Do not add your user, or any others, to this group.
browser_group_name=onepassword
browser_support_path=/opt/1Password/1Password-BrowserSupport
mcp_group_name=onepassword-mcp
mcp_path=/opt/1Password/1password-mcp
policy_path=/usr/share/polkit-1/actions/com.1password.1Password.policy
policy_template_path=/opt/1Password/com.1password.1Password.policy.tpl

group_exists() {
  getent group "$1" >/dev/null
}

ensure_group() {
  group_exists "$1" || groupadd "$1"
}

setup_helper() {
  chgrp "$1" "$2"
  chmod g+s "$2"
}

install_policy() {
  export POLICY_OWNERS
  POLICY_OWNERS="$(cut -d: -f1,3 /etc/passwd | grep -E ':[0-9]{4}$' | cut -d: -f1 | head -n 10 | sed 's/^/unix-user:/' | tr '\n' ' ')"
  install -dm755 /usr/share/polkit-1/actions
  eval "cat <<EOF
$(cat "${policy_template_path}")
EOF" > "${policy_path}"
  chmod 644 "${policy_path}"
}

pre_install() {
  ensure_group "${browser_group_name}"
  ensure_group "${mcp_group_name}"
}

pre_upgrade() {
  pre_install
}

post_install() {
  install_policy
  setup_helper "${browser_group_name}" "${browser_support_path}"
  setup_helper "${mcp_group_name}" "${mcp_path}"
}

post_upgrade() {
  post_install
}

post_remove() {
  rm -f "${policy_path}"
  if group_exists "${browser_group_name}"; then
    groupdel "${browser_group_name}"
  fi
  if group_exists "${mcp_group_name}"; then
    groupdel "${mcp_group_name}"
  fi
}
