{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "custom.regex",
    "github-actions"
  ],
  "dependencyDashboard": false,
  "packageRules": [
    {
      "description": "Pin GitHub Actions to immutable commit SHAs",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "description": "Update Arch Linux container images monthly",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "archlinux"
      ],
      "schedule": [
        "monthly"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)PKGBUILD$/"
      ],
      "matchStrings": [
        "pkgver=(?<currentValue>[^\\s#]+)\\s+# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ]
}
