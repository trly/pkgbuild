# Maintainer: Travis Lyons <pkgbuild at trly dot dev>
pkgname=opencode-desktop
pkgver=1.18.24 # renovate: datasource=github-tags depName=anomalyco/opencode
pkgrel=2
pkgdesc="Open source AI coding agent desktop client"
arch=('x86_64')
url="https://opencode.ai"
license=('MIT')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'glib2' 'glibc'
         'gtk3' 'hicolor-icon-theme' 'libcups' 'libdrm' 'libgcc' 'libnotify' 'libsecret' 'libstdc++' 'libx11' 'libxcb'
         'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon'
         'libxrandr' 'libxss' 'libxtst' 'mesa' 'nspr' 'nss' 'pango' 'ripgrep'
         'systemd-libs' 'util-linux-libs' 'xdg-utils')
optdepends=('libappindicator-gtk3: tray icon support')
options=('!debug' '!strip')
noextract=("${pkgname}-${pkgver}-amd64.deb")
source=("LICENSE-${pkgver}::https://raw.githubusercontent.com/anomalyco/opencode/v${pkgver}/LICENSE")
source_x86_64=("${pkgname}-${pkgver}-amd64.deb::https://github.com/anomalyco/opencode/releases/download/v${pkgver}/opencode-desktop-linux-amd64.deb")
sha256sums=('625f0f619133f89bbbb2abe37369613dfa1885eba1e50d02170deb62bb42cb6b')
sha256sums_x86_64=('d6446439e2d3361cc4f9eb6a7c485faef7ac31fbafb2d8721441e794a01450a8')

prepare() {
  bsdtar -xf "${srcdir}/${pkgname}-${pkgver}-amd64.deb" data.tar.xz
}

package() {
  bsdtar --no-same-owner -xf data.tar.xz -C "${pkgdir}"

  rm -f "${pkgdir}/opt/OpenCode/resources/app-update.yml" \
        "${pkgdir}/opt/OpenCode/resources/apparmor-profile" \
        "${pkgdir}/opt/OpenCode/resources/package-type" \
        "${pkgdir}/opt/OpenCode/resources/app.asar.unpacked/node_modules/@msgpackr-extract/msgpackr-extract-linux-x64/node.napi.musl.node" \
        "${pkgdir}/opt/OpenCode/resources/app.asar.unpacked/node_modules/@msgpackr-extract/msgpackr-extract-linux-x64/node.abi115.musl.node"
  rm -rf "${pkgdir}/opt/OpenCode/resources/app.asar.unpacked/node_modules/@parcel/watcher-linux-x64-musl"
  install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # Electron's sandbox requires the setuid bit.
  chmod 4755 "${pkgdir}/opt/OpenCode/chrome-sandbox"
}
