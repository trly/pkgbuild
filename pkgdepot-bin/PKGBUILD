# Maintainer: Travis Lyons <pkgbuild at trly dot dev>
pkgname=pkgdepot-bin
pkgver=0.2.2 # renovate: datasource=github-tags depName=trly/pkgdepot
pkgrel=1
pkgdesc="Arch Linux package repository server"
arch=('x86_64')
url="https://github.com/trly/pkgdepot"
license=('MIT')
provides=("pkgdepot=${pkgver}")
conflicts=('pkgdepot')
options=('!debug' '!strip')
source=("${pkgname}-${pkgver}-linux-amd64.tar.gz::${url}/releases/download/v${pkgver}/pkgdepot_${pkgver}_linux_amd64.tar.gz")
sha256sums=('441ff17351e6ab06c1e59b07353976080d570bb5359cdc3a76ea1f81dd13d7eb')

package() {
  install -Dm755 pkgdepot "${pkgdir}/usr/bin/pkgdepot"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
